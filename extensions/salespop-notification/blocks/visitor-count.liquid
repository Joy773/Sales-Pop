{% comment %}
  Visitor Count App Block
  Injects the container and script that renders the visitor count widget on the storefront.
{% endcomment %}

<meta name="shop" content="{{ shop.permanent_domain }}">
<script>
  window.SalesPopShop = "{{ shop.permanent_domain }}";
  {% if shop.metafields.app_salespop.app_url %}
    window.SalesPopAppUrl = "{{ shop.metafields.app_salespop.app_url }}";
  {% else %}
    window.SalesPopAppUrl = "https://platforms-magical-postage-coaches.trycloudflare.com";
  {% endif %}
</script>
{% if shop.metafields.app_salespop.app_url or app.metafields.app_salespop.app_url %}
  <meta name="salespop-app-url" content="https://platforms-magical-postage-coaches.trycloudflare.com">
{% endif %}

<div id="salespop-visitor-count-container" style="display:none;"></div>

<script src="{{ 'visitor-count.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Visitor Count Widget",
  "target": "body",
  "settings": []
}
{% endschema %}

